# backend/.env.example
# Copy to backend/.env for local dev. Every KZ_* variable consumed by the
# backend's Settings class lives here.

# Dev DB — matches compose.yaml service
KZ_DATABASE_URL=postgresql+psycopg://klassenzeit:klassenzeit@localhost:5433/klassenzeit_dev
KZ_DB_POOL_SIZE=5
KZ_DB_MAX_OVERFLOW=10
KZ_DB_ECHO=false

# Auth
KZ_COOKIE_SECURE=false
KZ_SESSION_TTL_DAYS=14
KZ_PASSWORD_MIN_LENGTH=12
KZ_LOGIN_MAX_ATTEMPTS=5
KZ_LOGIN_LOCKOUT_MINUTES=15

# Solver
# Wall-clock deadline for the LAHC pass (set to 0 to skip LAHC and run greedy only).
KZ_SOLVE_DEADLINE_MS=5000
# Which solver backend to dispatch (one of: lahc, lahc_rr, lahc_rr_kempe, cpsat).
# Default `lahc` matches pre-Sprint-4 behaviour. The `cpsat` backend depends
# on the `ortools` Python wheel which ships with `klassenzeit-solver`. ADR 0030.
KZ_SOLVER_BACKEND=lahc
